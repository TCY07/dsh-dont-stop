{
  "name": "dsh-dont-stop",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "description": "Keeps an agent working continuously over long stretches: set a deadline, and if it finishes the task early, Dont-Stop automatically nudges it to keep iterating and take on the next step on its own.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TCY07/dsh-dont-stop.git"
  },
  "homepage": "https://github.com/TCY07/dsh-dont-stop#readme",
  "bugs": {
    "url": "https://github.com/TCY07/dsh-dont-stop/issues"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "automation",
    "autonomous",
    "deadline",
    "supervision",
    "retry",
    "keep-awake",
    "power-management"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./core/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts.json",
    "core/index.js",
    "core/projection.js",
    "core/prompts.js",
    "core/settings.js",
    "power/*.js",
    "retry/index.js",
    "retry/prompts.js",
    "shared/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "core/icon.svg",
    "docs/images/*.png",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
